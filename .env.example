# =====================================================================
# Central Acadêmica — variáveis de ambiente (copie para .env.local)
# NUNCA versione valores reais.
# =====================================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Somente servidor. Usada apenas para exclusão de conta. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (links de convite e redefinição de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Inteligência artificial (somente servidor). Sem chave, a interface
# permanece disponível e informa que a integração precisa ser configurada.
# ---------------------------------------------------------------------
# Provedor de chat: openai | anthropic
# Opções: anthropic (claude-opus-5-5 ou claude-haiku-5-5) | google (gemini-3.5-flash) | openai
AI_CHAT_PROVIDER=google
AI_CHAT_MODEL=gemini-3.5-flash
# Esforço de raciocínio (Anthropic): low | medium | high | xhigh | max | none
AI_EFFORT=medium
# Provedor de embeddings (busca semântica): openai | none
# Busca por significado: openai (text-embedding-3-small) | google (gemini-embedding-001, 1536 dim.)
AI_EMBEDDING_PROVIDER=google
AI_EMBEDDING_MODEL=gemini-embedding-001

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Limites por usuário
AI_DAILY_REQUEST_LIMIT=100
AI_MONTHLY_TOKEN_LIMIT=2000000
AI_MAX_OUTPUT_TOKENS=4096
# ---------------------------------------------------------------------
# Assinatura / PagBank (somente servidor)
# ---------------------------------------------------------------------
# Token de integração do PagBank (Conta PagBank → Integrações). NUNCA versione.
PAGBANK_TOKEN=
# sandbox (testes) | production (cobrança real)
PAGBANK_ENV=sandbox
# Valor em centavos e duração de cada período pago
SUBSCRIPTION_PRICE_CENTS=3990
SUBSCRIPTION_PERIOD_DAYS=30

# Custo estimado (USD por 1M tokens) para o registro de uso
AI_COST_INPUT_PER_MTOK=4
AI_COST_OUTPUT_PER_MTOK=20
AI_COST_EMBEDDING_PER_MTOK=0.02
